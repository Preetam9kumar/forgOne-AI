# Copy to .env and fill in for production. All values have safe local-dev
# defaults (see app/config.py) so the app runs with none of this set.

# --- Database ---
# Local dev default: sqlite:///./dev.db (no setup needed)
# Production: postgresql+psycopg2://<user>@<host>:5432/<dbname>
DATABASE_URL=sqlite:///./dev.db

# --- API security / admin write access ---
AUTH_MODE=none
INGEST_API_KEY=<your-ingest-api-key>
AZURE_AD_TENANT_ID=<your-tenant-id>
AZURE_AD_CLIENT_ID=<your-server-app-client-id>
AZURE_AD_AUDIENCE=<your-app-id-uri-or-client-id>

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Azure AI Foundry / Azure OpenAI (required only for the live RAG explanation chain) ---
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
AZURE_AI_API_KEY=<your-foundry-api-key>
AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-admin-key>
AZURE_SEARCH_INDEX_NAME=supplier-facts
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_CHAT_DEPLOYMENT=gpt-4o

# --- Ranking default weights (must sum to ~1.0, but engine re-normalizes anyway) ---
DEFAULT_PRICE_WEIGHT=0.35
DEFAULT_LEAD_TIME_WEIGHT=0.25
DEFAULT_QUALITY_WEIGHT=0.25
DEFAULT_SUSTAINABILITY_WEIGHT=0.15

# --- Observability ---
SENTRY_DSN=
ENVIRONMENT=production
